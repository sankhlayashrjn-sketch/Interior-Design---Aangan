# --- Modes: live | mock. Mock logs what would have been sent; no keys needed. ---
AI_MODE=mock
HUBSPOT_MODE=mock
TELEGRAM_MODE=mock
CALCOM_MODE=mock

# --- App ---
APP_BASE_URL=http://localhost:3000
# A folder (local PGlite, no server needed) or a Postgres URL (Neon pooled connection string) in production.
DATABASE_URL=./data/pglite
# Optional, for migrations only: the DIRECT (non-pooled) Neon string. Used by the build step when set.
# DATABASE_URL_UNPOOLED=

# --- Where services.md, pricing.md, qualified.md live ---
CONTEXT_DIR=context

# --- POST /api/calls requires header x-api-key with this value. REQUIRED in production (it refuses all calls without it). ---
INGEST_API_KEY=

# --- Login. One shared password protects the dashboards. REQUIRED in production (without it the app locks itself). ---
APP_PASSWORD=
# Optional: signs the login cookie. Defaults to a value derived from APP_PASSWORD.
AUTH_SECRET=

# --- Secret for GET /api/cron/tick (Vercel Cron sends it automatically when set). REQUIRED in production. ---
CRON_SECRET=

# --- Cal.com (CALCOM_MODE=live) ---
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=
CALCOM_EVENT_TYPE_ID=

# --- Anthropic (AI_MODE=live) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- HubSpot Private App token (server-side only; HUBSPOT_MODE=live) ---
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=

# --- Telegram (TELEGRAM_MODE=live) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Vaanivoice.ai (integration deferred; see README "Connecting Vaani") ---
VAANI_API_KEY=
VAANI_AGENT_ID=
# From the studio, not yet checked against Vaani docs:
VAANI_BASE_URL=https://api.vaanivoice.ai
# webhook | poll. Not confirmed whether Vaani sends end-of-call webhooks.
VAANI_INGEST_MODE=
VAANI_WEBHOOK_SECRET=

# --- Cost tracking (INR) ---
# PLACEHOLDER rates, not real prices. Replace with your telephony rate and your model's current price.
TELEPHONY_COST_PER_MIN_INR=1.5
AI_INPUT_COST_PER_MTOK_INR=250
AI_OUTPUT_COST_PER_MTOK_INR=1250
